{
  "name": "@opticlm/streamup",
  "version": "1.4.0",
  "description": "A lightweight, headless React streaming markdown renderer",
  "type": "module",
  "types": "dist/index.d.mts",
  "sideEffects": ["*.css"],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./mermaid": {
      "types": "./dist/mermaid/index.d.mts",
      "default": "./dist/mermaid/index.mjs"
    },
    "./pele": {
      "types": "./dist/pele/index.d.mts",
      "default": "./dist/pele/index.mjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": ["dist/**/*.mjs", "dist/**/*.d.mts", "dist/styles.css", "LICENSE"],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "prepublishOnly": "npm run build"
  },
  "keywords": ["markdown", "stream"],
  "author": "EFLKumo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/OpticLM/streamup"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "peerDependenciesMeta": {
    "mermaid": {
      "optional": true
    },
    "pele": {
      "optional": true
    }
  },
  "dependencies": {
    "@pierre/words": "^0.2.2",
    "hast-util-from-html-isomorphic": "^2.0.0",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@pierre/highlights": "^0.5.2",
    "@testing-library/react": "^16.3.3",
    "@types/hast": "^3.0.5",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/unist": "^3.0.3",
    "jsdom": "^30.1.3",
    "mermaid": "^12.2.0",
    "pele": "^1.13.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
